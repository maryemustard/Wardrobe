# Copy to .env and fill in. Never commit .env.

# --- Backend ---
DATABASE_URL=postgresql+psycopg://wardrobe:wardrobe@localhost:5432/wardrobe
CORS_ORIGINS=http://localhost:5173
ENVIRONMENT=dev
# Where uploaded item photos are stored. Defaults to backend/media/ locally;
# on Railway set this to a path inside the mounted volume, e.g. /data/media
MEDIA_DIR=media

# --- App access (HTTP Basic Auth, single credential) ---
BASIC_AUTH_USER=me
BASIC_AUTH_PASS=change-me

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Frontend (build-time) ---
VITE_API_BASE_URL=http://localhost:8000
VITE_CLOUDINARY_CLOUD_NAME=
