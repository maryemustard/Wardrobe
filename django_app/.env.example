# Local development needs NONE of these — SQLite + an insecure dev key are the
# defaults. Copy to .env only when you deploy, and set real values.

DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=your-app.example.com

# Optional — turns on the "Suggest an outfit" page. Works locally too if set.
# Get one at https://console.anthropic.com  (pay-as-you-go, a few cents per suggestion)
ANTHROPIC_API_KEY=
