# Local development needs NONE of these — SQLite + an insecure dev key are the
# defaults. These are only for deploying (Railway etc.).

DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=your-app.up.railway.app
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-app.up.railway.app

# Provided automatically by Railway's PostgreSQL plugin — reference it, don't type it.
DATABASE_URL=

# Point this at a mounted volume so uploaded photos survive redeploys.
DJANGO_MEDIA_ROOT=/data/media

# Optional — turns on the "Suggest an outfit" page (also settable in the app's
# Settings page). Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=
